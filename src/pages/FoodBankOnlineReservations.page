<apex:page controller="FoodBankOnlineReservationService" showHeader="true" sidebar="false" docType="html-5.0">
<style>
.wcfb{max-width:1180px;margin:25px auto;font-family:Arial,sans-serif;color:#243349}.wcfb h1{font-size:25px}.wcfb table{border-collapse:collapse;width:100%;background:white}.wcfb th,.wcfb td{border:1px solid #d9e1e9;padding:8px;text-align:center}.wcfb th{background:#f0f4f8}.wcfb input{width:55px;padding:8px;border:1px solid #b8c6d4;border-radius:5px;text-align:center}.wcfb .missing{background:#f5f7f9;color:#c1c9d0}.wcfb button{background:#1876d2;color:white;border:0;padding:11px 22px;border-radius:6px;cursor:pointer}.wcfb #message{padding:12px}
</style>
<div class="wcfb"><h1>Online-Only Appointment Reservations</h1><p>Enter reserved online spaces for recurring weekday/time slots. Blank schedule cells cannot be edited. Saving applies rules to future appointments.</p><div id="grid">Loading schedule...</div><p><button onclick="save();return false;">Save and Apply to Future Appointments</button></p><div id="message" role="status"></div></div>
<script>
var cells=[], days=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function render(){var times={}, lookup={};cells.forEach(function(c){times[c.slotTime]=1;lookup[c.weekday+'|'+c.slotTime]=c;});var keys=Object.keys(times).sort(function(a,b){var x=cells.find(function(c){return c.slotTime===a;}),y=cells.find(function(c){return c.slotTime===b;});return a.localeCompare(b,undefined,{numeric:true});});var html='<table><thead><tr><th>Time</th>';days.forEach(function(d){html+='<th>'+d+'</th>';});html+='</tr></thead><tbody>';keys.forEach(function(t){html+='<tr><th>'+esc(t)+'</th>';for(var d=1;d<=7;d++){var c=lookup[d+'|'+t];html+=c?'<td><input type="number" min="0" max="999" step="1" data-day="'+d+'" data-time="'+esc(t)+'" value="'+c.reserved+'" /></td>':'<td class="missing">—</td>';}html+='</tr>';});html+='</tbody></table>';document.getElementById('grid').innerHTML=keys.length?html:'No appointment slots found in the next complete Monday–Sunday week.';}
function save(){var entries=[],invalid=false;document.querySelectorAll('#grid input').forEach(function(el){var n=Number(el.value);if(!Number.isInteger(n)||n<0||n>999)invalid=true;entries.push({weekday:Number(el.getAttribute('data-day')),time:el.getAttribute('data-time'),reserved:n});});if(invalid){document.getElementById('message').textContent='Enter whole numbers between 0 and 999.';return;}document.getElementById('message').textContent='Saving...';Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.FoodBankOnlineReservationService.saveGrid}',JSON.stringify(entries),function(result,event){document.getElementById('message').textContent=event.status?result:event.message;},{escape:true});}
Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.FoodBankOnlineReservationService.loadGrid}',function(result,event){if(event.status){cells=result||[];render();}else document.getElementById('grid').textContent=event.message;},{escape:true});
</script>
</apex:page>